# Veloci-Buy — environment
# .env holds ONLY endpoints, secrets and trading mode. Every tuning knob (gates, exits, fees,
# loop cadence, breakers) lives in strategies/standard.yaml; pick another file with STRATEGY.
# Legacy tuning keys set here are ignored with a startup warning. Full reference: docs/configuration.md

# --- Mode -------------------------------------------------------------------------------------
PAPER_TRADING=true             # simulated fills with a paper balance
DRY_RUN=false                  # live quotes, never sends a transaction
LIVE_TRADING_ENABLED=false     # required (true) when PAPER_TRADING=false and DRY_RUN=false
STRATEGY=standard              # strategies/<name>.yaml, merged over standard.yaml
BUY_AMOUNT_SOL=0.05
INITIAL_PAPER_SOL=0.1
CLOSE_POSITIONS_ON_SHUTDOWN=true

# --- Wallet (exactly one) ---------------------------------------------------------------------
# PRIVATE_KEY=                 # base58 secret key
# PRIVATE_KEY_PATH=./wallet.json
# KEYSTORE_PATH=./wallet.keystore.json   # encrypted keystore (npm run manage-keystore)
# KEYSTORE_PASSWORD=                     # leave unset to be prompted at startup

# --- Solana RPC -------------------------------------------------------------------------------
RPC_URL=https://api.mainnet-beta.solana.com   # comma-separate independent endpoints
# WS_RPC_URL=                  # blank = derived from RPC_URL
# RPC_TIER=premium,free        # per endpoint; auto-detected when unset
# RPC_RATE_LIMITS=50,5         # req/s per endpoint (defaults: premium 10, free 5)
# RPC_SEND_TX_RATE_LIMITS=5,1
# HELIUS_API_KEY=              # enables Helius transactionSubscribe discovery

# --- Jupiter (Free tier: 1 req/s per organisation) --------------------------------------------
JUPITER_API_KEY=
# JUPITER_POSITION_API_KEY=    # monitor/exit/swap key; a 2nd organisation = an isolated budget
# JUPITER_BASE_URL=https://api.jup.ag
# JUPITER_RPS=1                # local bucket rate per key
# USE_JUPITER_SDK=true

# --- Security providers -----------------------------------------------------------------------
RUGCHECK_ENABLED=false
# RUGCHECK_API_KEY=            # free account key = 60 req/min
# RUGCHECK_RPS=1
BUBBLEMAPS_ENABLED=false
# BUBBLEMAPS_API_KEY=
# BUBBLEMAPS_RPM=6

# --- Jito (default 1 req/s per IP per region) -------------------------------------------------
USE_JITO=false
# JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
# JITO_TIP_FLOOR_API_URL=
# JITO_TIP_SOL=0.001
# JITO_RPS=1

# --- Geyser plugin stream (optional) ----------------------------------------------------------
# GEYSER_ENABLED=true          # only connects when an endpoint below is set
# GEYSER_TCP_ADDR=127.0.0.1:9123
# GEYSER_SOCKET_PATH=/tmp/veloci-geyser.sock

# --- Notifications ----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# --- Files (defaults are per-session under logs/) ---------------------------------------------
# STATE_FILE=                  # escape hatch: pin the SQLite state DB
# LOG_FILE=./bot.log
# SCANNED_TOKENS_FILE=./scanned-memecoins.jsonl
# ML_RESERVOIR_FILE=./data/ml-reservoir.db

# --- Advanced ---------------------------------------------------------------------------------
# PUMP_FEE_RECIPIENT=          # override the pinned pump.fun buyback fee recipient

# --- ML (optional) -----------------------------------------------------------------------------
ML_ENABLED=false
# ML_RETRAIN_INTERVAL_MS=900000
# ML_MIN_TRAINING_SAMPLES=30
# ML_GATE_MIN_REAL_TRADES=5
# ML_SCORE_GATE_THRESHOLD=0.35
# ML_SCORE_WEIGHT=0.3
# ML_RL_OPTIMIZER=true
# GHOST_TICK_INTERVAL_MS=1000
# GHOST_MAX_POSITIONS=3
# GHOST_MAX_HOLD_MINUTES=5
# GHOST_MIN_SCORE=60
# ENTRY_TUNER_ENABLED=true
# ENTRY_TUNER_LIVE_ENABLED=false
# ENTRY_TUNER_MIN_SAMPLES=15
# ADAPTIVE_FLOOR_ENABLED=true
# ADAPTIVE_FLOOR_LIVE_ENABLED=false
