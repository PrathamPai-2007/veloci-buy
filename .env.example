# ╔══════════════════════════════════════════════════════════════════════════╗
# ║                  VELOCI-BUY · ENVIRONMENT TEMPLATE                       ║
# ║                                                                          ║
# ║  Copy to `.env` and fill in the secrets. Every value below is OPTIONAL   ║
# ║  unless marked (REQUIRED) — unset keys fall back to the defaults shown.  ║
# ║  Commented-out (`#`) keys are either secrets or off-by-default overrides.║
# ║                                                                          ║
# ║  Strategy presets in strategies/*.yaml set many entry/exit defaults; the ║
# ║  matching env var here OVERRIDES the active preset when set.             ║
# ╚══════════════════════════════════════════════════════════════════════════╝


# ═══════════════════════════════════════════════════════════════════════════
#  1 · NETWORK & API ENDPOINTS
# ═══════════════════════════════════════════════════════════════════════════

# (REQUIRED) Solana RPC endpoint(s). Comma-separated for a failover pool.
# Must support WebSockets for real-time discovery.
# NOTE: Burst mode (section 13) is RPC-intensive — all pricing falls onto on-chain
# getMultipleAccounts curve reads and will 429 on a public/free node. Use a premium
# dedicated provider for burst, or list multiple endpoints here so rpcCall rotates on 429.
RPC_URL=https://your-solana-rpc
# Optional override for the WebSocket URL(s) (otherwise derived from RPC_URL).
# Comma-separated list matching RPC_URL is supported if overrides are desired.
# Leave unset (RECOMMENDED) to automatically derive fallbacks from RPC_URL
# to support automatic WebSocket rotation on connection drops/failures.
# WS_RPC_URL=wss://your-solana-ws

# (REQUIRED) Jupiter API key — used for swap routing and price data.
# RATE LIMIT WARNING: Jupiter enforces limits per *account*, not per key. All API calls
# (swap quotes, price fetches, token lookups) share one bucket. Discovery scans, position
# monitoring, and price fetches can collide at peak activity and trigger 429 errors —
# especially on exits. Creating extra keys from the same Jupiter account does NOT help.
#
# To eliminate 429s choose one:
#   Option A — Two separate Jupiter accounts (free): register a second account at
#              https://dev.jup.ag, generate a key there, and set JUPITER_POSITION_API_KEY
#              to that key. The sniper uses JUPITER_API_KEY for discovery; the monitor and
#              exit executor use JUPITER_POSITION_API_KEY. Separate accounts = separate buckets.
#   Option B — Upgrade to a paid Jupiter tier (higher RPS, single account).
#              See https://developers.jup.ag/docs/portal/rate-limits for tier details.
#
# Transient single-call 429s self-heal: the bot backs off price calls for ~30s and leans
# on the on-chain price fallback. The real risk is a 429 on an exit sell — that drops the
# exit entirely. Do NOT raise concurrency or polling frequency to compensate.
JUPITER_API_KEY=your-jupiter-api-key
# Key from a *second* Jupiter account, dedicated to position monitoring and exit sells.
# When set, the monitor and exit paths use this key; discovery uses JUPITER_API_KEY.
# Required to avoid 429 collisions between discovery and exits. See note above.
# JUPITER_POSITION_API_KEY=your-second-account-jupiter-api-key
JUPITER_BASE_URL=https://api.jup.ag

# ── RugCheck (REQUIRED) ──────────────────────────────────────────────────────
# Free Solana token security API. Key is mandatory — bot refuses to start without it.
# Get a free key at https://rugcheck.xyz (Dashboard → API Keys).
# Rate limits: 10 req/min unauthenticated (unusable at scan speed), 60 req/min with free key.
# See docs/rate-limits.md for full rate limit details and tuning guidance.
RUGCHECK_API_KEY=your-rugcheck-api-key
RUGCHECK_BASE_URL=https://api.rugcheck.xyz/v1
RUGCHECK_ENABLED=false

# ── BubbleMaps (optional, paid) ───────────────────────────────────────────────
# Wallet clustering / decentralization score. No free equivalent.
# Disabled when key is absent — on-chain top5 concentration check runs instead.
# BUBBLEMAPS_API_KEY=your-bubblemaps-key
BUBBLEMAPS_BASE_URL=https://api.bubblemaps.io
BUBBLEMAPS_ENABLED=false


# ═══════════════════════════════════════════════════════════════════════════
#  2 · WALLET & TRADING MODE
# ═══════════════════════════════════════════════════════════════════════════

# Active strategy preset — maps to a file in strategies/ (e.g. strategies/standard.yaml).
STRATEGY=standard

# Provide EXACTLY ONE wallet source: PRIVATE_KEY, PRIVATE_KEY_PATH, or KEYSTORE_PATH.
# PRIVATE_KEY=your-wallet-private-key            # Base58-encoded secret key
# PRIVATE_KEY_PATH=./wallet.json                 # path to a keypair.json
# KEYSTORE_PATH=./wallet.keystore.json           # encrypted keystore (npm run manage-keystore)
# KEYSTORE_PASSWORD=changeme                      # leave unset to be prompted at startup

# ── Mode switches (safe defaults: simulate everything) ──
# Simulate transactions without broadcasting them to the network.
DRY_RUN=true
# Hard arming switch — real live swaps are refused unless this is true.
LIVE_TRADING_ENABLED=false
# Trade against a local virtual balance instead of real SOL.
PAPER_TRADING=true
# Starting SOL balance for paper-trading mode.
INITIAL_PAPER_SOL=0.1


# ═══════════════════════════════════════════════════════════════════════════
#  3 · DASHBOARD API (WebSocket)
# ═══════════════════════════════════════════════════════════════════════════

# Port the dashboard WebSocket API listens on (src/services/api.service.ts).
API_PORT=8080
# Interface the API binds to. Default 127.0.0.1 = localhost only (safe). Set to
# 0.0.0.0 to expose on the network for a remote dashboard (only with API_TOKEN set).
API_HOST=127.0.0.1
# Shared token clients must send as ?token= to connect. STRONGLY recommended in
# production: empty = unauthenticated, and switching to LIVE from the dashboard is
# refused entirely when unset. Leave blank for local dev: `npm run dev:all`
# auto-generates one here and mirrors it into website/.env.local automatically.
API_TOKEN=
# Use the high-performance Jupiter SDK for execution.
USE_JUPITER_SDK=true
# Simulate the swap inline before broadcasting to catch failures early.
INLINE_SWAP_SIMULATION=true
# Reclaim rent by closing empty token accounts in the background after a full exit.
BACKGROUND_ATA_CLOSE=true


# ═══════════════════════════════════════════════════════════════════════════
#  4 · EXECUTION · ORDER SIZE, SLIPPAGE & ROUTING
# ═══════════════════════════════════════════════════════════════════════════

# SOL spent per new entry.
BUY_AMOUNT_SOL=0.05
# Max swap slippage in basis points (500 = 5%).
SLIPPAGE_BPS=500
# Auto-slippage retry loop on slippage-failed swaps.
MAX_AUTO_SLIPPAGE_RETRY=3
AUTO_SLIPPAGE_INCREMENT_BPS=100
# Cap a single buy at this fraction of pool liquidity (0.15 = 15%) so entries stay
# exitable. Enforced at execution time in buy.ts, past the latency-critical snipe.
MAX_BUY_LIQUIDITY_FRACTION=0.15

# ── Local router (optional) ──
# Bypass external routers and build Pump.fun bonding-curve swaps directly for lower latency.
ENABLE_LOCAL_ROUTING=true
LOCAL_ROUTING_COMPUTE_UNIT_LIMIT=100000

# ── Jito / MEV protection ──
# Route transactions through the Jito Block Engine (atomic, frontrun-protected bundles).
USE_JITO=true
# Scale the Jito tip dynamically by ML confidence + congestion (else use the static tip).
DYNAMIC_JITO_TIP_ENABLED=false
# Static fallback tip in SOL (converted to lamports internally).
JITO_TIP_SOL=0.001
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
# Percentile of the live tip floor to target when dynamic tipping.
JITO_TIP_PERCENTILE=75
# Optional explicit tip-floor API URL (defaults to the block engine's getTipFloor).
# JITO_TIP_FLOOR_API_URL=
# Bundle confirmation polling timeout (ms) and re-sign retry attempts.
JITO_CONFIRM_TIMEOUT_MS=30000
JITO_BUNDLE_RETRY_ATTEMPTS=3
# Probabilistic buy tip: cap the tip at this fraction of the trade's expected profit
# (0.25 = 25%) so high-conviction bids never overpay.
JITO_TIP_MAX_FRACTION_OF_EV=0.25

# ── Priority fees (micro-lamports) ──
PRIORITY_FEE_BASE_MICRO_LAMPORTS=25000
PRIORITY_FEE_MAX_MICRO_LAMPORTS=5000000
# Tip multiplier applied during a market-dump panic exit.
PRIORITY_FEE_PANIC_MULTIPLIER=2.0
# Percentile of observed network fees to target.
PRIORITY_FEE_PERCENTILE=75
# Extra multiplier during high volatility, and whether to estimate fees locally.
PRIORITY_FEE_VOLATILITY_MULTIPLIER=1.0
PRIORITY_FEE_ACCOUNT_LOCAL=true


# ═══════════════════════════════════════════════════════════════════════════
#  5 · PORTFOLIO RISK & CONCURRENCY
# ═══════════════════════════════════════════════════════════════════════════

# Maximum concurrent open positions.
MAX_OPEN_POSITIONS=10
# Max concurrent positions sharing one launchpad (sector cap). 0 disables the per-launchpad cap.
MAX_POSITIONS_PER_LAUNCHPAD=0
# Scale position size by ML confidence / regime instead of a fixed BUY_AMOUNT_SOL.
DYNAMIC_SIZING_ENABLED=false

# Kelly-fraction position sizing. Scales stake by ML confidence using half-Kelly formula.
# Only activates when model is trained (not shadow mode) and KELLY_MIN_TRADES real closed
# trades have accumulated. At confidence=0.5 → no change. High confidence → up to
# (1 + MAX_KELLY_FRACTION)× base; low confidence → down to (1 - MAX_KELLY_FRACTION)×.
KELLY_ENABLED=false
# MAX_KELLY_FRACTION: max upsize/downsize as fraction of base stake (default 0.25 = ±25%).
# MAX_KELLY_FRACTION=0.25
# KELLY_MIN_TRADES: min real closed trades required before Kelly activates (default 10).
# KELLY_MIN_TRADES=10

# ── Drawdown circuit breaker ──
# Master switch. On a large session loss, new buys pause; the breaker auto-resumes later.
CIRCUIT_BREAKER_ENABLED=true
# Pause new entries once session drawdown from the peak balance exceeds this fraction (0.30 = 30%).
MAX_DAILY_DRAWDOWN_PCT=0.30
# After the breaker trips, pause this many minutes, then re-baseline and auto-resume.
DRAWDOWN_COOLDOWN_MINUTES=30

# ── Loss-streak breaker ──
# After N consecutive losing positions, pause new entries for a short cooldown so the bot
# stops firing into a hostile tape (faster than the coarse drawdown breaker).
LOSS_STREAK_BREAKER_ENABLED=true
LOSS_STREAK_THRESHOLD=3
LOSS_STREAK_COOLDOWN_MINUTES=15

# ── Scan throughput & adaptive backpressure (keep low/high for the 1 RPS free tier) ──
# Maximum new buys per discovery scan cycle.
MAX_BUYS_PER_SCAN=2
# Maximum candidates evaluated per scan.
MAX_CANDIDATES_PER_SCAN=5
# Audit worker concurrency.
MAX_CONCURRENT_AUDITS=10
SCAN_PARALLELISM_LIGHT=8
SCAN_PARALLELISM_HEAVY=3
OWNER_AUDIT_PARALLELISM=2
# Per-mint price-fallback workers (keep at 1 for 1 RPS).
PRICE_FALLBACK_PARALLELISM=1
# Concurrency floor during timeout/rate-limit bursts, and the adaptive backpressure window.
PARALLELISM_MIN_FACTOR=0.5
ERROR_RATE_WINDOW=20
BACKPRESSURE_ERROR_RATE_THRESHOLD=0.30
# RPC indexing-lag retry tuning for full audits.
MINT_SIGNAL_MAX_ATTEMPTS=3
MINT_SIGNAL_RETRY_DELAY_MS=750
RPC_INDEXING_RETRY_DELAY_MS=15000


# ═══════════════════════════════════════════════════════════════════════════
#  6 · DISCOVERY (new-mint ingestion)
# ═══════════════════════════════════════════════════════════════════════════

# Main discovery scan interval (keep high for 1 RPS).
SCAN_INTERVAL_MS=15000
# Backup REST poll of Jupiter /tokens/v2/recent. WebSockets handle real-time discovery,
# so this is just a safety net — lowering it significantly increases Jupiter API usage.
DISCOVERY_POLL_INTERVAL_MS=30000
# Near-instant WebSocket discovery + per-DEX toggles (reduce WS noise).
DISCOVERY_WS_ENABLED=true
DISCOVERY_PUMP_ENABLED=true
DISCOVERY_RAYDIUM_ENABLED=true
DISCOVERY_METEORA_ENABLED=true
# Debounce window to batch concurrent WS init signals.
DISCOVERY_WS_DEBOUNCE_MS=750
# Rotate to a backup node if slot/log notifications go silent past the stale threshold.
WEBSOCKET_WATCHDOG_INTERVAL_MS=10000
WEBSOCKET_STALE_THRESHOLD_MS=30000
# Timeout (ms) for the initial @solana/kit subscription handshake. All logsNotifications /
# accountNotifications / signatureNotifications subscribe() calls race against this timeout
# because @solana/kit can silently ignore AbortSignal during the initial connection.
# WEBSOCKET_HANDSHAKE_TIMEOUT_MS=15000

# Optional Helius API key — enables Helius transactionSubscribe as a faster discovery path
# alongside the standard logsNotifications stream. When set, new-mint signals from Helius
# arrive before the standard RPC WS subscription. Requires a paid Helius plan.
# HELIUS_API_KEY=your-helius-api-key


# ═══════════════════════════════════════════════════════════════════════════
#  7 · TRENDING DISCOVERY (Jupiter top-traded feed, pump.fun only)
# ═══════════════════════════════════════════════════════════════════════════

# Poll pump.fun's "trending" set (coins the crowd is actively buying) and audit them first.
TRENDING_DISCOVERY_ENABLED=true
# Top-traded ranking window (e.g. 5m, 1h, 24h) and poll cadence.
TRENDING_INTERVAL=5m
TRENDING_POLL_INTERVAL_MS=20000
# Trending-ONLY relaxed anti-top guards. Trending coins have, by definition, already run,
# so the "it already pumped" rejections are loosened moderately for them (new-mint flow
# keeps the stricter section-9 values).
TRENDING_MAX_SURVIVAL_GROWTH_PCT=900
TRENDING_MAX_BUY_TOP_GROWTH_PCT=250
TRENDING_MAX_PRICE_DUMP_PCT=30
TRENDING_MAX_TOKEN_ACCOUNT_TOP1_PCT=80
TRENDING_MAX_TOKEN_ACCOUNT_TOP5_PCT=80
TRENDING_MIN_BUBBLEMAPS_SCORE=40


# ═══════════════════════════════════════════════════════════════════════════
#  8 · GLOBAL ENTRY FILTERS (security & valuation floors)
# ═══════════════════════════════════════════════════════════════════════════

# Liquidity floor (USD) and organic-score floor.
MIN_LIQUIDITY_USD=750
MIN_ORGANIC_SCORE=0
# Minimum unique holders.
MIN_HOLDER_COUNT=2
# Holder-concentration rug filters: top-N share caps (% of supply).
# TOP1: single-wallet cap (tightened from 70 → 40; a single wallet at 70% can rug in one tx).
# TOP3: bundler/insider detection (new) — coordinated snipes often cluster in top-3 wallets.
# TOP5: the single highest-ROI entry filter; empirically separates winners from losers.
MAX_AUDIT_TOP_HOLDERS_PCT=95
MAX_TOKEN_ACCOUNT_TOP1_PCT=40
MAX_TOKEN_ACCOUNT_TOP3_PCT=30
MAX_TOKEN_ACCOUNT_TOP5_PCT=85
# top-5 share above which an insider dump is treated as a full-panic rug (rather than a
# routine de-risk trim). Below it, holder churn is treated as normal.
INSIDER_DRIFT_CONCENTRATION_TOP5=0.6
# FDV/liquidity ratio + max meme FDV (USD).
MAX_FDV_TO_LIQUIDITY=80
MAX_MEME_FDV_USD=10000000
# Market-cap floor (FDV proxy) — drops dust/dead launches once market data exists.
MIN_MARKET_CAP_USD=1000
# Optional comma-separated keyword override for the memecoin heuristic.
# MEME_KEYWORDS=ai,ape,bonk,cat,dog,pepe,pump,sol
# Minimum buys in the last 5 minutes / minimum pool age before evaluation.
MIN_BUYS_5M=1
MIN_POOL_AGE_SECONDS=0
# Maximum candidate age (minutes) to still count as "fresh".
MAX_CANDIDATE_AGE_MINUTES=30
# Minimum social links (X / TG / Website) and whether Jupiter-verified tokens are allowed.
MIN_SOCIAL_LINKS=0
ALLOW_VERIFIED_TOKENS=true
# Minimum overall entry score (0-100) required to pass.
MIN_CANDIDATE_SCORE=75


# ═══════════════════════════════════════════════════════════════════════════
#  9 · AUDIT & MOMENTUM ENGINE (survival window)
# ═══════════════════════════════════════════════════════════════════════════

# Add a signed momentum/flow delta (≈ -10..+12) on top of the structural entry score.
# The base score ranks token *cleanliness* (socials, liquidity, holders); this delta adds
# *thrust* — 5m buy/sell imbalance, buy-flow acceleration, and price trajectory off the
# survival baseline. Mainly a downside filter: tokens visibly dumping get demoted.
# Set false to score on structure alone.
MOMENTUM_SCORING_ENABLED=true

# Survival observation window, and score thresholds that extend it (adaptive caution).
SURVIVAL_DELAY_SECONDS=10
SURVIVAL_DELAY_THRESHOLD_HIGH=75
SURVIVAL_DELAY_THRESHOLD_VERY_HIGH=90
# Seconds for the final fact-check audit, and max rechecks per candidate.
FINAL_AUDIT_SECONDS=5
MAX_RECHECK_ATTEMPTS=6

# Momentum gates during the survival window.
MIN_SURVIVAL_MOMENTUM=0.98          # required price hold/gain (1.00x = flat)
MIN_BREAKOUT_MULTIPLIER=1.000       # minimum breakout (1.001 = +0.1%)
MAX_PRICE_DUMP_PCT=20               # max tolerated dump during the window
MAX_SURVIVAL_GROWTH_PCT=300         # avoid parabolic "top-sniping"
MAX_LIQUIDITY_DRAWDOWN_PCT=25       # max liquidity drain during the window

# "Buying the top" guards (avoid entering over-extended peaks).
MAX_BUY_TOP_GROWTH_PCT=120
BUY_TOP_ATH_BUFFER_PCT=2
BUYING_THE_TOP_SL_PCT=25

# Shape filters.
MIN_MOMENTUM_CONSISTENCY=0.45       # min ratio of green vs red price snapshots
MAX_EXHAUSTION_RANGE_PCT=1.6        # flatline / exhaustion detector
MIN_ACCELERATION_FACTOR=0.16        # min buy-flow acceleration between segments
MAX_SELL_PRESSURE_INCREASE_PCT=100  # max sell-pressure rise allowed during the delay

# Borderline-candidate recheck controls (give near-miss candidates a second look).
BORDERLINE_RECHECK_ENABLED=true
BORDERLINE_RECHECK_MIN_DELAY_MS=8000
BORDERLINE_RECHECK_MAX_DELAY_MS=20000
BORDERLINE_RECHECK_MAX_ATTEMPTS=3
BORDERLINE_THRESHOLD_BUFFER_PCT=20
# Score at/above which a candidate is treated as high-confidence for TP planning.
HIGH_GROWTH_CONFIDENCE_SCORE=70


# ═══════════════════════════════════════════════════════════════════════════
#  10 · RISK MANAGEMENT (exits)
# ═══════════════════════════════════════════════════════════════════════════

# Trailing stop drawdown from peak (0.20 = exit on a 20% drop from the high).
TRAILING_STOP_DRAWDOWN_PCT=0.20
# Static stop-loss from entry (0.2 = 20%).
STOP_LOSS_PCT=0.2

# Milestone take-profit: sell TAKE_PROFIT_FRACTION of the position at each multiple.
TAKE_PROFIT_MULTIPLES=1.5
TAKE_PROFIT_FRACTION=0.60
# High-confidence TP multiples — used instead of TAKE_PROFIT_MULTIPLES when the ML score
# meets highGrowthConfidenceScore (HIGH_GROWTH_CONFIDENCE_SCORE, default 70). Allows more
# aggressive ladders for high-conviction entries. Defaults to the strategy preset.
# TAKE_PROFIT_MULTIPLES_HIGH=2.0,4.0

# Breakeven ratchet: after a TP target banks, raise the stop to ~entry (+buffer for
# fees/slippage) so a winner can't round-trip into a loss.
BREAKEVEN_RATCHET_ENABLED=true
BREAKEVEN_RATCHET_BUFFER_PCT=0.01

# Break-even stop: once unrealized gain ever touches >= threshold, raise stop to ~entry.
# Prevents pump-and-dump tokens from reversing into a net loss before TP1 is reached.
BREAK_EVEN_STOP_ENABLED=true
BREAK_EVEN_STOP_THRESHOLD_PCT=0.07
BREAK_EVEN_STOP_BUFFER_PCT=0.005

# Graduated initial stop: tighten stop in first 60s/3m after entry, relax to normal thereafter.
# Caps losses on stale fills and immediate dumps before position has proven itself.
EARLY_STOP_LOSS_PCT=0.08
EARLY_STOP_LOSS_WINDOW_SEC=30
MID_STOP_LOSS_PCT=0.13
MID_STOP_LOSS_WINDOW_SEC=120

# Moon-Bag Runner: reserve a small tranche, exempt from routine take-profit, that rides a
# wider trailing stop to keep a free option on a moonshot. Trailing 0.24 = exit once it
# gives back 24% of peak (i.e. holds while above 76% of peak).
MOON_BAG_FRACTION=0.1
MOON_BAG_TRAILING_DRAWDOWN_PCT=0.24

# Early-performance guard: fires from rugExitWindowSec (15s) up to earlyPerformanceGuardSeconds (60s).
# Rug-exit owns 0-15s; EPG picks up where it leaves off.
EARLY_PERFORMANCE_GUARD_SECONDS=60
EARLY_PERFORMANCE_DROP_PCT=10
EARLY_PERFORMANCE_SELL_PCT=60

# Rug-exit guard: exit immediately if price drops, spread widens, or volume collapses within the first N seconds of entry.
# Catches post-peak entries, pool drains, and dead wash-trading momentum.
RUG_EXIT_GUARD_ENABLED=true
RUG_EXIT_WINDOW_SEC=15
RUG_EXIT_DROP_PCT=0.05
RUG_EXIT_DYNAMIC_SCALING_ENABLED=true
RUG_EXIT_MICRO_CAP_THRESHOLD_USD=100000
RUG_EXIT_MICRO_CAP_MULTIPLIER=1.8
RUG_EXIT_HIGH_CAP_THRESHOLD_USD=500000
RUG_EXIT_HIGH_CAP_MULTIPLIER=0.7
RUG_EXIT_VOLATILITY_SCALING_ENABLED=true
RUG_EXIT_SPREAD_GUARD_ENABLED=true
RUG_EXIT_MAX_SPREAD_PCT=0.15
RUG_EXIT_SPREAD_EXPANSION_MULTIPLIER=2.0
RUG_EXIT_VOLUME_GUARD_ENABLED=true
RUG_EXIT_SELL_DOMINANCE_MULTIPLIER=2.5

# Secondary holding check.
# PERFORMANCE_CHECK_SECONDS=600
PERFORMANCE_MIN_MOMENTUM=1.05

# Time-based exits.
MIN_HOLD_TIME_SECONDS=60
MAX_HOLD_MINUTES=60
TIME_EXIT_MIN_MULTIPLE=1.25

# Liquidity-collapse emergency exit (hard USD floor OR fraction of entry pool depth).
LIQUIDITY_COLLAPSE_THRESHOLD_USD=750
LIQUIDITY_COLLAPSE_THRESHOLD_RATIO=0.25


# ═══════════════════════════════════════════════════════════════════════════
#  11 · THIRD-PARTY SECURITY SCORING
# ═══════════════════════════════════════════════════════════════════════════

# RugCheck is always active (key required — see section 1). BubbleMaps thresholds apply when
# BUBBLEMAPS_API_KEY is set (optional). When BubbleMaps is absent the on-chain top5
# concentration gate runs with a tighter -10% threshold as fallback.
MIN_BUBBLEMAPS_SCORE=60
MAX_BUBBLEMAPS_LARGEST_CLUSTER_SHARE=0.20


# ═══════════════════════════════════════════════════════════════════════════
#  12 · RE-ENTRY & COOLING
# ═══════════════════════════════════════════════════════════════════════════

# Minutes before re-evaluating the same mint after an exit.
COOL_DOWN_MINUTES=20
# Seconds to wait before re-evaluating low-holder-count tokens.
HOLDER_COUNT_WAITLIST_SECONDS=33
# Minutes to pause discovery if win-rate drops too low (mood system).
MOOD_PAUSE_DURATION_MINUTES=60
# Re-entry gate: price must be at least this far below/above the last exit.
REENTRY_DIP_PCT=15
REENTRY_BREAKOUT_PCT=20
# Confidence-tuned hold durations and recheck dip trigger.
HOLD_DURATION_HIGH_CONFIDENCE_MINUTES=10
HOLD_DURATION_LOW_CONFIDENCE_MINUTES=5
RECHECK_PRICE_DROP_PCT=15


# ═══════════════════════════════════════════════════════════════════════════
#  13 · BURST MODE (optional high-speed breakout strategy)
# ═══════════════════════════════════════════════════════════════════════════

# Opt-in breakout mode for volatile memecoins (small-wave patterns, tight stops, short holds).
# When true it overrides the active strategy preset with burst values. The TP ladders default
# to the preset unless explicitly set below.
# REQUIRES A PREMIUM RPC: burst prices fresh pump.fun mints via on-chain getMultipleAccounts
# curve reads (Jupiter can't price them), which 429s on public/free nodes. See docs/rate-limits.md.
BURST_MODE_ENABLED=false
BURST_SURVIVAL_SECONDS=1.5
BURST_MIN_MOMENTUM=1.02
BURST_MAX_ENTRY_DRAWDOWN_PCT=8
BURST_MIN_BUY_SELL_RATIO=1.5
BURST_TRAILING_DRAWDOWN_PCT=0.18
BURST_MAX_HOLD_MINUTES=10
BURST_MAX_SOL_OUTFLOW_PCT=0.05
# Optional comma-separated overrides (default to the strategy preset's burst ladders).
# BURST_TAKE_PROFIT_MULTIPLES=1.03,1.06,1.1
# BURST_TAKE_PROFIT_FRACTIONS=0.4,0.4,0.2


# ═══════════════════════════════════════════════════════════════════════════
#  14 · ADAPTIVE ML LEARNING
# ═══════════════════════════════════════════════════════════════════════════

# Master switch: enable the neural scoring gate + parameter optimizer.
ML_ENABLED=false
# Retrain + optimizer cadence (ms). Default 15 min.
ML_RETRAIN_INTERVAL_MS=900000
# Closed trades needed before the model leaves shadow mode.
ML_MIN_TRAINING_SAMPLES=30
# Hard ML gating stays advisory-only until this many REAL closed trades exist.
ML_GATE_MIN_REAL_TRADES=5
# Min model confidence (0-1) to pass the gate once active, and its blend weight in the score.
ML_SCORE_GATE_THRESHOLD=0.35
ML_SCORE_WEIGHT=0.3
# Opt-in: native PPO RL exit optimizer instead of the central-difference optimizer
# (requires the Rust addon).
ML_RL_OPTIMIZER=true

# ── Ghost trader (virtual paper positions for training; requires ML_ENABLED=true) ──
GHOST_TICK_INTERVAL_MS=1000
GHOST_MAX_POSITIONS=5
GHOST_MAX_HOLD_MINUTES=15
# Min candidateScore to open a ghost position (defaults to MIN_CANDIDATE_SCORE if unset).
# GHOST_MIN_SCORE=60

# ── Entry-gate auto-tuner (adapts gates to the day's regime; requires ML_ENABLED=true) ──
ENTRY_TUNER_ENABLED=true
# Allow gate adjustments in LIVE trading too (default false = paper-mode only).
ENTRY_TUNER_LIVE_ENABLED=false
ENTRY_TUNER_MIN_SAMPLES=15

# ── Adaptive entry floor (keeps the bot sampling in a dead market instead of freezing) ──
# In a low-activity regime the entry-score gate loosens toward a floor and relaxes further
# the longer no buy executes, rather than tightening.
ADAPTIVE_FLOOR_ENABLED=true
# Apply the adaptive floor in LIVE trading too (default false = paper-mode only).
ADAPTIVE_FLOOR_LIVE_ENABLED=false
# Lowest the gate may relax to (never raised above the base MIN_CANDIDATE_SCORE).
MIN_CANDIDATE_SCORE_FLOOR=50
# Minutes with no executed buy before the starvation controller starts relaxing the gate,
# and the points removed per elapsed interval (clamped to the floor).
TRADE_STARVATION_MINUTES=10
STARVATION_RELAX_STEP=3


# ═══════════════════════════════════════════════════════════════════════════
#  15 · PERSISTENCE, LOGGING & NOTIFICATIONS
# ═══════════════════════════════════════════════════════════════════════════

# Debounce interval (ms) for batched WAL-mode SQLite state flushes.
STATE_FLUSH_INTERVAL_MS=250
# Market-sell all open positions on shutdown (SIGINT/SIGTERM).
CLOSE_POSITIONS_ON_SHUTDOWN=true

# Optional notifications.
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-telegram-chat-id
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional file paths (auto-generated under logs/ when unset).
# STATE_FILE=./bot-state.json
# LOG_FILE=./bot.log
# SCANNED_TOKENS_FILE=./scanned-memecoins.jsonl


# ═══════════════════════════════════════════════════════════════════════════
#  16 · SWING BOT (graduated-token swing trader)
# ═══════════════════════════════════════════════════════════════════════════

# Enable the swing bot alongside the sniper. Targets tokens whose bonding curve
# is complete (graduated to Raydium/Meteora) using double-dip W-pattern detection
# and volume-accumulation signals.  Runs as a separate 4th interval loop.
#
# Volume accuracy tiers (automatic, no config needed):
#   Tier 1 (default) — Jupiter stats5m (5-min aggregated counts, always available)
#   Tier 2           — Tick-level Raydium AMM swap logs via WebSocket logsSubscribe.
#                      Activates automatically when a Raydium pool is found for the
#                      token via api-v3.raydium.io.  Uses SOL-volume comparison
#                      instead of raw count comparison — significantly more reliable.
SWING_BOT_ENABLED=false

# Dedicated Jupiter API key for swing price/swap calls (rate-limit is isolated from
# the sniper's key). Defaults to JUPITER_API_KEY when unset.
# SWING_JUPITER_API_KEY=your-swing-jupiter-api-key
# SWING_JUPITER_BASE_URL=https://api.jup.ag

# Market-cap window for graduated tokens (USD FDV).
SWING_MIN_MARKET_CAP_USD=10000
SWING_MAX_MARKET_CAP_USD=10000000

# SOL amount to spend per swing entry.
SWING_BUY_AMOUNT_SOL=0.05

# Maximum concurrent open swing positions.
SWING_MAX_OPEN_POSITIONS=3

# ── Observation & polling ──────────────────────────────────────────────────
# How often (ms) to poll the watchlist for new price points and run evaluation.
SWING_WATCHLIST_POLL_INTERVAL_MS=20000
# Minimum minutes a token must be observed before evaluation is allowed.
SWING_MIN_OBSERVATION_MINUTES=30

# ── Signal detection ───────────────────────────────────────────────────────
# Enable/disable individual signal components.
SWING_DOUBLE_DIP_ENABLED=true
SWING_VOLUME_ACCUM_ENABLED=true
# Minimum composite score (0–100) required to enter.
SWING_MIN_SCORE=60
# Allows entry confirmation when no volume data is available at all.
SWING_ALLOW_DOUBLE_DIP_ONLY=false
# Score floor for double-dip-only entries when volume data is missing.
SWING_MIN_SCORE_NO_VOLUME=55


# ── Exit parameters ────────────────────────────────────────────────────────
# Flat stop-loss / trailing stop width (0.25 = 25% drawdown).
SWING_TRAILING_STOP_PCT=0.25
# Comma-separated take-profit multipliers.  Partial sell fractions must sum to ≤1.
SWING_TAKE_PROFIT_MULTIPLES=1.5,3.0,7.0
SWING_TAKE_PROFIT_FRACTIONS=0.4,0.3,0.2
# Maximum hold time before a time-exit is triggered.
SWING_MAX_HOLD_HOURS=24


# ═══════════════════════════════════════════════════════════════════════════
#  17 · GEYSER INGESTION (optional latency accelerator)
# ═══════════════════════════════════════════════════════════════════════════

# Low-latency account stream from a validator running the Geyser plugin.
# Enabled by default (GEYSER_ENABLED=true); RPC polling always remains the fallback.
GEYSER_ENABLED=true
# Connect over TCP (host:port) OR a Unix Domain Socket path — set exactly one.
# GEYSER_TCP_ADDR=127.0.0.1:9999
# GEYSER_SOCKET_PATH=/tmp/veloci-geyser.sock
