# Copy to .env (or .env.local) and adjust. All vars are build-time (Vite),
# so they are embedded in the bundle — never put secrets here.

# WebSocket URL of the bot's API server (src/services/api.service.ts).
# Use wss:// when the site is served over HTTPS.
VITE_WS_URL=ws://localhost:8080

# Shared token sent as ?token= to authenticate against the bot's API_TOKEN.
# Must match API_TOKEN in the bot's .env. Leave empty only for trusted localhost.
VITE_WS_TOKEN=

# Firebase web config. These identify the project and are NOT secrets, but can
# be overridden to point at a different Firebase project per environment.
# Leave unset to use the built-in default project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
